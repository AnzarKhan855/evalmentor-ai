# ==============================================================================
# EvalMentor AI - Backend Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure the values for your environment.
# DO NOT commit real secrets or production API keys to source control.

# MongoDB Connection
# Get this from MongoDB Atlas or use a local instance (e.g. mongodb://localhost:27017)
MONGODB_URL=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
DATABASE_NAME=evalmentor_ai

# Security & Authentication
# Generate a secure 256-bit secret (e.g. `openssl rand -hex 32`)
JWT_SECRET_KEY=your_secure_jwt_secret_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Groq AI Service Configuration
# Obtain your API key from https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# CORS Configuration
# Allowed frontend domain (in addition to localhost and evalmentor-ai.vercel.app)
FRONTEND_URL=https://evalmentor-ai.vercel.app
